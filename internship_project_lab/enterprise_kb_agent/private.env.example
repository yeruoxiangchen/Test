# Copy to /data/zjr/enterprise_kb_agent/private.env; chmod 600. No credentials in source control.
# extractive: working document retrieval + verbatim excerpts; no LLM calls.
# agent: real model-driven tool calling; requires a compatible chat-completions endpoint.
KB_MODE=extractive
KB_HOST=127.0.0.1
KB_PORT=8768
# Set to 1 when serving behind an HTTPS reverse proxy.
KB_SECURE_COOKIE=0

# KB_MODE=agent
# KB_LLM_BASE_URL=http://127.0.0.1:8000/v1
# KB_LLM_MODEL=your-tool-capable-model
# KB_LLM_API_KEY=your-key-if-required
# KB_TOKENIZE_URL=http://127.0.0.1:8000/tokenize
# KB_CONTEXT_TOKENS=8192
# KB_OUTPUT_TOKENS=1400
# KB_ENABLE_THINKING=0

# Optional semantic retrieval. After changing endpoint/model, reindex documents.
# KB_EMBED_BASE_URL=http://127.0.0.1:8001/v1
# KB_EMBED_MODEL=your-embedding-model
# KB_EMBED_API_KEY=your-key-if-required

# Optional independent evaluation judge; never used for ordinary chat.
# KB_JUDGE_BASE_URL=http://127.0.0.1:8002/v1
# KB_JUDGE_MODEL=independent-judge-model
# KB_JUDGE_API_KEY=if-required
